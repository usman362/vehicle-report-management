{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "ink",
					"color": "#0b1a2b",
					"name": "Ink"
				},
				{
					"slug": "navy",
					"color": "#122c47",
					"name": "Navy"
				},
				{
					"slug": "accent",
					"color": "#1b6fb3",
					"name": "Accent"
				},
				{
					"slug": "highlight",
					"color": "#e3b23c",
					"name": "Highlight"
				},
				{
					"slug": "deep",
					"color": "#071321",
					"name": "Deep"
				},
				{
					"slug": "background",
					"color": "#f4f7fb",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "Surface"
				},
				{
					"slug": "border",
					"color": "#dde5ee",
					"name": "Border"
				},
				{
					"slug": "success",
					"color": "#13764b",
					"name": "Success"
				},
				{
					"slug": "danger",
					"color": "#b93838",
					"name": "Danger"
				},
				{
					"slug": "muted",
					"color": "#55687c",
					"name": "Muted text"
				}
			],
			"gradients": [
				{
					"slug": "hero",
					"name": "Hero",
					"gradient": "linear-gradient(135deg, #071321 0%, #122c47 48%, #1b4a78 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "clamp(1.6rem, 1.2rem + 1.6vw, 2.25rem)",
					"name": "Extra large"
				},
				{
					"slug": "xx-large",
					"size": "clamp(2rem, 1.4rem + 2.6vw, 3rem)",
					"name": "Display"
				},
				{
					"slug": "display",
					"size": "clamp(2.25rem, 1.5rem + 2.9vw, 3.5rem)",
					"name": "Hero display"
				}
			],
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.75rem",
					"name": "1"
				},
				{
					"slug": "30",
					"size": "1.25rem",
					"name": "2"
				},
				{
					"slug": "40",
					"size": "2rem",
					"name": "3"
				},
				{
					"slug": "50",
					"size": "3rem",
					"name": "4"
				},
				{
					"slug": "60",
					"size": "4.5rem",
					"name": "5"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2rem)",
				"right": "clamp(1rem, 4vw, 2rem)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--navy)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.15",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(1.75rem, 1.2rem + 2vw, 2.6rem)",
					"lineHeight": "1.25",
					"fontWeight": "650",
					"letterSpacing": "-0.015em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "650"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "12px"
				},
				"spacing": {
					"padding": {
						"top": "0.95rem",
						"bottom": "0.95rem",
						"left": "1.9rem",
						"right": "1.9rem"
					}
				},
				"typography": {
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--navy)",
						"text": "var(--wp--preset--color--surface)"
					}
				}
			}
		},
		"blocks": {
			"core/group": {
				"spacing": {
					"padding": {
						"top": "0",
						"bottom": "0"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
