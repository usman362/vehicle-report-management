{
    "name": "vehicle-report-uk/vehicle-report-management",
    "description": "UK vehicle report ordering and manual fulfilment website (WordPress + WooCommerce + custom plugin).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "VehicleReportOrders\\": "wp-content/plugins/vehicle-report-orders/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    }
}
