<?xml version="1.0"?>
<ruleset name="Vehicle Report Orders">
    <description>WordPress coding standards for the custom plugin and theme only; WordPress core and third-party plugins are excluded.</description>

    <!-- Production code only. The PHPUnit suite follows PHPUnit conventions
         and is verified by `composer test`, not by the WordPress sniffs. -->
    <file>wp-content/plugins/vehicle-report-orders</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="6.6"/>
    <config name="testVersion" value="8.1-"/>

    <rule ref="WordPress">
        <!-- PSR-4 class files, so the WordPress file-naming rule does not apply. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>
    <rule ref="PHPCompatibilityWP"/>

    <!-- PHPCompatibility does not yet recognise enum methods as object context,
         so it reports $this and self inside an enum as PHP 7.1 breakage.
         Both are valid in the PHP 8.1 minimum this plugin requires. -->
    <rule ref="PHPCompatibility.Variables.ForbiddenThisUseContexts.OutsideObjectContext">
        <exclude-pattern>*/Domain/FulfillmentStatus.php</exclude-pattern>
        <exclude-pattern>*/Domain/CoverageOutcome.php</exclude-pattern>
    </rule>
    <rule ref="PHPCompatibility.FunctionDeclarations.NewParamTypeDeclarations.SelfOutsideClassScopeFound">
        <exclude-pattern>*/Domain/FulfillmentStatus.php</exclude-pattern>
        <exclude-pattern>*/Domain/CoverageOutcome.php</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="vehicle-report-orders"/>
            </property>
        </properties>
    </rule>
</ruleset>
